PORT=3000
APP_SECRET=troque-por-uma-chave-longa-e-aleatoria
COOKIE_SECURE=false

# IA: transcrição + seleção dos melhores trechos
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Recursos legados da v6, mantidos como fallback
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
PEXELS_API_KEY=

# Instagram / Meta
META_GRAPH_API_VERSION=v24.0
PUBLIC_BASE_URL=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Vídeo e armazenamento
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
DATA_DIR=./data
DATABASE_PATH=./data/viraclip-v7.sqlite
MEDIA_DIR=./data/media
UPLOAD_DIR=./data/uploads

# YouTube: DESATIVADO por padrão. Habilite somente após revisar os termos
# aplicáveis e para fluxos em que exista autorização adequada.
ENABLE_YOUTUBE_IMPORT=false
YTDLP_BIN=yt-dlp
