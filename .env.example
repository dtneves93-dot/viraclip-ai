PORT=3000
APP_SECRET=troque-por-uma-chave-longa-e-aleatoria
COOKIE_SECURE=false

# IA gratuita: transcrição + seleção dos melhores trechos
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
NODE_OPTIONS=--require=./groq-shim.js

# Instagram / Meta
META_GRAPH_API_VERSION=v24.0
PUBLIC_BASE_URL=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Vídeo e armazenamento
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
DATA_DIR=./data
DATABASE_PATH=./data/viraclip-v7.sqlite
MEDIA_DIR=./data/media
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=3221225472

# Importação por URL fica desligada por padrão
ENABLE_YOUTUBE_IMPORT=false
